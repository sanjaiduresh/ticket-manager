# Copy to .env.server.local (ignored). These values are SERVER-ONLY.
# Do not use a VITE_ prefix for any credential.
MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dsa_service_desk
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=3001
# Production: set NODE_ENV=production and APP_ORIGINS=https://your-app.example
# TRUST_PROXY=loopback
# Set TRUST_PROXY only to your verified reverse proxy IP/subnet, never blindly true.